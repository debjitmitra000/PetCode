{
  "name": "codepet",
  "displayName": "CodePet",
  "description": "A virtual pet that lives inside your VS Code editor — reacts to your typing, errors, idle time, and even the hour of night.",
  "version": "0.1.0",
  "publisher": "debjitmitra000",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other", "Visualization"],
  "keywords": [
    "pet",
    "dog",
    "cat",
    "tamagotchi",
    "companion",
    "animation",
    "fun",
    "virtual pet",
    "coding companion",
    "productivity"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/codepet"
  },
  "homepage": "https://github.com/YOUR_USERNAME/codepet#readme",
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/codepet/issues"
  },
  "qna": "marketplace",
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "paw-icon": {
        "description": "CodePet paw icon",
        "default": {
          "fontPath": "./media/codepet-icons.woff",
          "fontCharacter": "\\E000"
        }
      },
      "dog-icon": {
        "description": "CodePet dog icon",
        "default": {
          "fontPath": "./media/codepet-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "cat-icon": {
        "description": "CodePet cat icon",
        "default": {
          "fontPath": "./media/codepet-icons.woff",
          "fontCharacter": "\\E002"
        }
      }
    },
    "commands": [
      { "command": "codepet.bark",      "title": "CodePet: Make your pet bark" },
      { "command": "codepet.toggle",    "title": "CodePet: Toggle pet visibility" },
      { "command": "codepet.openPanel", "title": "CodePet: Open settings" }
    ],
    "keybindings": [
      { "command": "codepet.bark", "key": "ctrl+alt+b", "mac": "cmd+alt+b" }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.80.0",
    "typescript": "^4.9.4"
  }
}